# Shared secret the desktop client sends in its "hello" message
AUTH_TOKEN=change-me

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Gemini 1.5 Flash is shut down. Default: current stable Flash.
# Lower-latency alternative: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high  (3.x models)  ·  off = thinking_budget 0 (2.5 models)  ·  empty = model default
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_S=4.0

# Supabase -> Project Settings -> Database -> Connection string (direct or Session pooler, port 5432)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# STT engine: parakeet | none (none = text-only test mode)
# Parakeet TDT 0.6B v3 runs on CPU (onnx-asr, onnxruntime, int8). No GPU needed.
STT_ENGINE=parakeet
# onnxruntime threads for Parakeet: 2-4. Fewer threads = less CPU load, slower clips.
PARAKEET_THREADS=3
# Optional local model folder (encoder-model.int8.onnx, decoder_joint-model.int8.onnx, vocab.txt, config.json).
# Empty = downloaded from Hugging Face (istupakov/parakeet-tdt-0.6b-v3-onnx) on first start.
PARAKEET_MODEL_PATH=
# Drop clips Parakeet returns in English (it can't be forced to Polish)
STT_POLISH_ONLY=true

EMBED_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=4
# e5 cosine similarities sit high (0.7-0.95); tune on your data
RAG_MIN_SIMILARITY=0.80

MASTER_PROMPT_PATH=../prompts/master_prompt_pl.md
HISTORY_TURNS=8
